{
  "manifest_version": 2,
  "name": "MyShield",
  "version": "1.0",
  "description": "A security and privacy hardening extension for Firefox.",
  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "tabs",
    "downloads",
    "storage",
    "notifications",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_action": {
    "default_title": "MyShield",
    "default_popup": "popup/popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "myshield@example.com",
      "strict_min_version": "115.0"
    }
  }
}
